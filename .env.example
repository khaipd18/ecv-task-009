# ==========================================================
# Copy file này thành .env rồi sửa. KHÔNG commit file .env
# ==========================================================

# --- UID: BẮT BUỘC đặt = kết quả của lệnh `id -u` ---
# WSL/Linux thường là 1000. macOS đặt 50000.
# Sai chỗ này -> thư mục logs/ thuộc root -> Airflow không ghi được log.
AIRFLOW_UID=1000

TZ=Asia/Ho_Chi_Minh

# --- Postgres (superuser, dùng cho metadata DB) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_pw_doi_di
POSTGRES_HOST_PORT=5433

# --- 3 database trong cùng 1 container ---
AIRFLOW_DB=airflow
SUPERSET_DB=superset
APP_DB=olist

# --- User cho DB nghiệp vụ ---
APP_DB_USER=olist_user
APP_DB_PASSWORD=olist_pw_doi_di

# --- User read-only cho Superset ---
SUPERSET_RO_USER=superset_ro
SUPERSET_RO_PASSWORD=superset_ro_pw_doi_di

# --- Airflow ---
# Sinh key: docker run --rm apache/airflow:2.10.5 python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=DOI_KEY_NAY_DI_khong_de_mac_dinh_1234567890=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_HOST_PORT=8080

# --- Superset ---
# Sinh key: openssl rand -base64 42
SUPERSET_SECRET_KEY=DOI_KEY_NAY_DI_openssl_rand_base64_42
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_HOST_PORT=8088
